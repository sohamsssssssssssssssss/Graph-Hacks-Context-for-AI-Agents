# FalkorDB Connection Settings
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=
FALKORDB_GRAPH=keystone

# Legacy endpoint/key fallback (also accepted by the Groq grader)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# Local agent; all K/B1/B2 runs share this model.
AGENT_PROVIDER=ollama
AGENT_MODEL=qwen2.5:7b-instruct
AGENT_BASE_URL=http://127.0.0.1:11434

# Independent Groq grader; legacy LLM_API_KEY is accepted as fallback.
GRADER_MODEL=openai/gpt-oss-120b
GRADER_BASE_URL=https://api.groq.com/openai/v1
GRADER_API_KEY=
