Cypher [keystone_real]:
MATCH (p:PathPattern)
OPTIONAL MATCH (p)-[e:OWNS]->(o:Owner)
RETURN properties(p), o.handle, e.owner_order ORDER BY p.order, e.owner_order
Parameters: {}
